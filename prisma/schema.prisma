// SautiSafe — Prisma schema (local testing instance in the Z cloud)
// This schema is mirrored 1:1 in /convex/schema.ts for the future
// Vercel + Convex production deployment. See convex/MIGRATION.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person who reports or is involved in an incident.
/// Names are intentionally optional to support anonymous reporting.
model Worker {
  id          String     @id @default(cuid())
  identifier  String?    // staff/employee code, optional
  displayName String?    // optional display name
  role        String?    // e.g. "Operator", "Supervisor", "Contractor"
  department  String?    // e.g. "Boiler House", "Logistics", "Maintenance"
  createdAt   DateTime   @default(now())
  incidents   Incident[]
}

/// A safety incident or near-miss report.
/// The heart of SautiSafe: created from a voice report, enriched by the
/// extraction pipeline, clarified by follow-ups, and reviewed by a supervisor.
model Incident {
  id            String      @id @default(cuid())
  referenceNo   String      @unique // human-friendly, e.g. SSA-2026-0001
  workerId      String?
  worker        Worker?     @relation(fields: [workerId], references: [id])

  // --- Raw voice inputs ---
  audioFileName String?
  audioMimeType String?
  audioSizeBytes Int?
  audioDurationSec Int?
  rawTranscript String? // primary transcript (the chosen/final one)

  // --- Structured safety fields (extracted by the LLM) ---
  location      String? // where it happened
  equipment     String? // equipment / asset involved
  hazard        String? // what the hazard / incident was
  peopleAffected String? // who was affected / at risk
  immediateAction String? // what was done immediately
  injuryStatus  String? // none | minor | serious | unknown
  severity      String? // low | medium | high | critical
  occurredAt    DateTime? // when it happened (parsed from speech or set manually)

  // --- Risk + workflow state ---
  status        String      @default("draft") // draft | extracted | review | submitted | escalated | resolved
  isUrgent      Boolean     @default(false)
  urgencyTags   String? // JSON array: ["fire","chemical","electrocution", ...]
  consentGiven  Boolean     @default(false)
  detectedLanguage String? // e.g. "eng+lug"

  // --- Supervisor review ---
  supervisorNotes String?
  reviewedBy     String?
  reviewedAt    DateTime?

  // --- Relations ---
  followUps     FollowUp[]
  transcripts   Transcript[]
  auditEvents   AuditEvent[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

/// A follow-up question the system asked to fill missing information,
/// and the worker's answer (text or voice-derived).
model FollowUp {
  id          String    @id @default(cuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  field       String? // which structured field this addresses (e.g. "location")
  question    String
  answer      String?
  askedAt     DateTime  @default(now())
  answeredAt  DateTime?
}

/// One transcription of an incident's audio by a given provider.
/// An incident may have several (one per speech model) when benchmarking.
model Transcript {
  id          String    @id @default(cuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  provider    String    // "sahara" | "whisper" | "gemini" | "zai-asr"
  text        String
  language    String?
  durationMs  Int?
  latencyMs   Int?
  wordCount   Int?
  confidence  Float?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

/// A benchmark run compares multiple speech models on the same audio +
/// reference transcript, computing accuracy metrics.
model BenchmarkRun {
  id               String   @id @default(cuid())
  referenceNo      String
  scenario        String? // human label: "Heavy code-switch, noisy background"
  audioFileName   String?
  referenceTranscript String
  resultsJson     String // JSON: [{provider, text, wer, cer, criticalTermRecall, latencyMs, ...}]
  aggregateMetrics String? // JSON: { avgWer, avgCer, ... }
  createdAt       DateTime @default(now())
}

/// Append-only audit trail for every meaningful action on an incident.
model AuditEvent {
  id          String    @id @default(cuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action      String // e.g. "recorded", "transcribed", "extracted", "escalated", "reviewed"
  actor       String?
  detail      String?
  createdAt   DateTime  @default(now())
}
