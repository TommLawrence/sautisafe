# SautiSafe environment variables (example).
# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored - never commit real secrets.

# Local SQLite database (test instance in the Z cloud)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Convex public deployment URL (set in Vercel and .env.local)
NEXT_PUBLIC_CONVEX_URL=

# Intron Voice (Sahara) speech-to-text API.
# Get a key at https://voice.intron.io/v2/developers
INTRON_API_KEY=
INTRON_BASE_URL=https://infer.voice.intron.io

# OpenAI Whisper (benchmark lane) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (benchmark lane) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model id; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# --- Production (Vercel + Convex) speech providers ---
# Set these on the Convex deployment, NOT in the browser bundle:
#   npx convex env set INTRON_API_KEY ...
#   npx convex env set INTRON_BASE_URL ...
#   npx convex env set OPENAI_API_KEY ...      (Whisper lane)
#   npx convex env set GEMINI_API_KEY ...      (Gemini lane)
#   npx convex env set GEMINI_MODEL ...        (default gemini-3.8-flash)
#   npx convex env set LLM_API_BASE ...        (extraction LLM)
#   npx convex env set LLM_API_KEY ...
#   npx convex env set LLM_MODEL ...           (default gpt-4o-mini)
